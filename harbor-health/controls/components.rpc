# One control per component: running state and image reference (repo prefix and tag).
# Mandatory components are gated on the proxy container existing; optional
# ones on their own container existing, except Trivy which is required
# unless require_trivy is false.

control "harbor-health-01" {
  title       = "Proxy (nginx) container is running and uses the expected goharbor image"
  description = "The ${var.proxy_container} container must be in the running state and its image must come from ${var.image_repo_prefix} and carry the tag given by harbor_version."
  remediation = "docker compose up -d from the Harbor installation directory; if the tag differs from harbor_version, either upgrade from the matching release bundle or run with --var harbor_version=<deployed tag>."
  impact      = 0.7
  tags = {
    app      = "harbor"
    category = "availability"
    severity = "high"
    nist     = "CP-10,SI-4,CM-2"
    iso27001 = "A.8.14,A.8.16,A.8.9"
  }
  ref {
    title = "Harbor: Troubleshooting Harbor Installation"
    url   = "https://goharbor.io/docs/2.15.0/install-config/troubleshoot-installation/"
  }
  ref {
    title = "NIST SP 800-53 Rev. 5: CP-10, SI-4, CM-2"
    url   = "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"
  }
  ref {
    title = "ISO/IEC 27001:2022 Annex A: A.8.14, A.8.16, A.8.9"
    url   = "https://www.iso.org/standard/27001"
  }
  only_if "command" {
    cmd         = "docker ps -a --format '{{.Names}}' | grep -qx '${var.proxy_container}'"
    exit_status = 0
  }
  check "running" "command" {
    cmd         = "docker inspect -f '{{.State.Running}}' '${var.proxy_container}'"
    exit_status = 0
    stdout_match {
      pattern = "true"
      mode    = "exact"
    }
  }
  check "image" "command" {
    cmd         = "docker inspect -f '{{.Config.Image}}' '${var.proxy_container}'"
    exit_status = 0
    stdout_match {
      pattern = "^${var.image_repo_prefix}[^:]+:${var.harbor_version}$"
      mode    = "regex"
    }
  }
}

